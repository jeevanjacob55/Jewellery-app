# Android Studio emulator (AVD)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api

# Render/Firebase preview environment for EAS internal distribution
# EXPO_PUBLIC_API_BASE_URL=https://preview-api.yourdomain.com/api

# Physical Android phone on the same Wi-Fi as your computer with Expo Go
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8000/api

# Genymotion emulator
# EXPO_PUBLIC_API_BASE_URL=http://10.0.3.2:8000/api

# Physical Android phone over USB with `adb reverse tcp:8000 tcp:8000`
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
