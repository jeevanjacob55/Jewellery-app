{
  "name": "jewellery-association-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-expo-lan.ps1",
    "start:clear": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-expo-lan.ps1 -Clear",
    "start:tunnel": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-expo-tunnel.ps1 -Clear",
    "start:dev-client": "expo start --dev-client --lan",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "lint": "tsc --noEmit",
    "ios": "expo run:ios",
    "usb:prepare": "powershell -ExecutionPolicy Bypass -File .\\scripts\\android-usb-prepare.ps1"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "expo": "^51.0.28",
    "expo-auth-session": "~5.5.2",
    "expo-dev-client": "~4.0.29",
    "expo-font": "~12.0.10",
    "expo-image-picker": "~15.0.7",
    "expo-status-bar": "^1.12.1",
    "expo-web-browser": "~13.0.3",
    "react": "18.2.0",
    "react-native": "^0.74.5",
    "react-native-safe-area-context": "^4.10.9",
    "react-native-screens": "^3.31.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
